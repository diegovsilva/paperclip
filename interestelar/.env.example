# Qual provider de LLM usar: groq | openai | anthropic. Só a *_API_KEY do provider
# escolhido precisa estar preenchida — as outras duas seções abaixo ficam vazias/ignoradas.
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.2
# Free tiers costumam ter TPM baixo; max_tokens conta no orçamento do request mesmo que
# a resposta real seja menor.
LLM_MAX_TOKENS=2048

# --- Groq (LLM_PROVIDER=groq) ---
GROQ_API_KEY=
# Catálogo muda com frequência — confira em https://console.groq.com/docs/models ou
# GET https://api.groq.com/openai/v1/models (com sua chave) antes de trocar.
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PAPERCLIP_API_URL=http://paperclip:3100/api
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# URL pela qual o container "paperclip" alcança o "harness" dentro da rede docker —
# use o hostname do serviço, não localhost. Só muda se você renomear o serviço no
# docker-compose.yml ou rodar o harness fora do compose.
HARNESS_PUBLIC_URL=http://harness:8000
BETTER_AUTH_SECRET=

GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

REVERSA_CLAUDE_CODE_AUTH=

HARNESS_WEBHOOK_SECRET=
HARNESS_HOST=0.0.0.0
HARNESS_PORT=8000

VAULT_PATH=./vault
REPOSITORIOS_PATH=./repositorios
SQLITE_PATH=./db/interestelar.db

LOG_LEVEL=INFO
